# Copier en `.env` pour surcharger les valeurs par défaut de app/config.py.
# En Docker Compose, ces variables sont fournies directement dans
# docker-compose.yml pour le service `api` (jamais en dur dans le code).

DATABASE_URL=postgresql+psycopg://bikeroute:bikeroute@localhost:5433/bikeroute
SESSION_DURATION_DAYS=14
SESSION_COOKIE_NAME=session_id
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=128
